# 依赖与构建产物
node_modules/
dist/
build/
*.tsbuildinfo

# 环境变量（绝不能提交：JWT 密钥、支付证书、数据库地址）
.env
.env.*
!.env.example

# 数据库（SQLite 单文件，含顾客手机号等数据，不进仓库）
*.db
*.db-journal
*.sqlite
apps/api/data/
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# 上传文件（门店图片、桌码、小票）
apps/api/uploads/
uploads/

# 日志
*.log
logs/
npm-debug.log*

# 本地验证临时产物
.playwright-cli/

# 编辑器与系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
apps/admin/.vite/
coverage/
