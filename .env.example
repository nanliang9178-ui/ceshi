# ============================================================
# 天枢点单 —— 环境变量模板
# 复制为 apps/api/.env 后按需修改；后台使用 apps/admin/.env
# ============================================================

# ---------- 基础 ----------
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# 对外访问地址：桌码二维码内容为 {PUBLIC_BASE_URL}/t/{桌位scene}
# 手机扫码必须能访问到该地址：局域网调试填电脑局域网 IP，生产填 https 域名
PUBLIC_BASE_URL=http://192.168.1.100:3000

# 管理后台地址（用于生成支付回调/分享链接，可留空）
ADMIN_BASE_URL=http://192.168.1.100:5173

# ---------- 数据库 ----------
# 单机 / 演示：SQLite（无需安装数据库）
DATABASE_URL=file:../data/app.db
# 生产建议切换 MySQL 8，切换步骤见 README「切换到 MySQL」

# ---------- 鉴权 ----------
# 生产环境务必替换为 32 位以上随机字符串
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=12h

# 敏感配置（微信支付密钥/证书）落库加密主密钥，必须是 32 字节 base64
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=

# ---------- 缓存（可选） ----------
# 留空则使用进程内缓存，单机部署足够；多实例部署请填 Redis
REDIS_URL=

# ---------- 上传 ----------
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# ---------- 微信登录（平台默认小程序） ----------
# 允许商户在后台覆盖为自己的小程序 AppID / AppSecret
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- 微信支付 ----------
# 演示模式：未配置商户支付参数时，下单走「模拟支付」，不影响点单全流程演示
ALLOW_MOCK_PAY=true

# ---------- 首次初始化的平台账号 ----------
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=admin888
SEED_DEMO=true
