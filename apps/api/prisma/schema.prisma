// 天枢点单 - 数据模型
// 说明：为保证「开箱即跑」，本地使用 SQLite；生产可平滑切换 MySQL（见 README）。
//      状态字段使用 String 存储，取值受 @tianshu/shared 中的常量约束。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 平台运营账号
model PlatformUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         String    @default("SUPER_ADMIN")
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// 商户（租户）
model Tenant {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  contactName  String?
  contactPhone String?
  status       String    @default("ACTIVE")
  plan         String    @default("BASIC")
  expireAt     DateTime?
  remark       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brand         TenantBrand?
  store         Store?
  staff         StaffUser[]
  paymentConfig PaymentConfig?
  tables        DiningTable[]
  categories    Category[]
  products      Product[]
  orders        Order[]
}

/// 品牌白标配置（换 logo / 主题色不改代码）
model TenantBrand {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  logoUrl      String?
  coverUrl     String?
  primaryColor String   @default("#FF5A1F")
  accentColor  String   @default("#F2B544")
  slogan       String?
  announcement String?
  servicePhone String?
  copyright    String?
  /// JSON 字符串数组，首页轮播图
  banners      String   @default("[]")
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// 门店（MVP 与商户 1:1，保留独立表便于后续扩展连锁）
model Store {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  name         String
  address      String?
  phone        String?
  businessHours String  @default("10:00-22:00")
  openStatus   Boolean  @default(true)
  autoAccept   Boolean  @default(false)
  /// 打包费（分，自取/堂食打包用）
  packingFee   Int      @default(0)
  /// 起送/起购金额（分）
  minOrderAmount Int    @default(0)
  /// 外卖配送费（分）
  deliveryFee      Int    @default(0)
  /// 外卖起送金额（分）
  deliveryMinAmount Int   @default(0)
  /// 配送范围说明（如「3 公里内，满 20 元起送」）
  deliveryRange    String?
  /// 预计送达时间（分钟）
  deliveryEta      Int    @default(30)
  /// 满减门槛（分，0 表示不启用）
  fullReduceThreshold Int @default(0)
  /// 满减金额（分）
  fullReduceAmount    Int @default(0)
  notice       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables DiningTable[]
}

/// 商户员工 / 后台账号
model StaffUser {
  id           String    @id @default(cuid())
  tenantId     String
  storeId      String?
  username     String
  passwordHash String
  name         String
  role         String    @default("STAFF")
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, username])
  @@index([tenantId])
}

/// 商户微信支付配置（私钥与 APIv3 密钥加密存储）
model PaymentConfig {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  appId         String?
  /// 商户小程序 AppSecret（加密存储，用于 code2session）
  appSecretEnc  String?
  mchId         String?
  apiV3KeyEnc   String?
  serialNo      String?
  privateKeyEnc String?
  notifyUrl     String?
  /// 生成小程序码使用的版本：release / trial / develop
  wxEnvVersion  String    @default("release")
  enabled       Boolean   @default(false)
  verifiedAt    DateTime?
  statusMsg     String?
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// 桌位
model DiningTable {
  id        String   @id @default(cuid())
  tenantId  String
  storeId   String
  /// 扫码 scene 短码，全局唯一，≤32 字符
  sceneCode String   @unique
  area      String   @default("大厅")
  name      String
  seats     Int      @default(4)
  qrCodeUrl String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, name])
  @@index([tenantId])
}

/// 菜品分类
model Category {
  id        String   @id @default(cuid())
  tenantId  String
  storeId   String
  name      String
  /// 分类图标（emoji 或单个字符，展示在横向分类条）
  icon      String?
  /// 左侧营销位角标文字（如「99元起」）
  promoLabel String?
  /// 左侧营销位标题（如「新人专区」）
  promoTitle String?
  sort      Int      @default(0)
  status    String   @default("ON")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId, sort])
}

/// 商品
model Product {
  id            String   @id @default(cuid())
  tenantId      String
  storeId       String
  categoryId    String
  name          String
  description   String?
  imageUrl      String?
  /// 基础价（分）
  price         Int
  /// 划线价（分）
  originalPrice Int?
  unit          String   @default("份")
  monthlySales  Int      @default(0)
  /// 商品标签，英文逗号分隔（招牌 / 新品 / 热销 / 折扣）
  tags          String   @default("")
  stockEnabled  Boolean  @default(false)
  stock         Int      @default(0)
  soldOut       Boolean  @default(false)
  status        String   @default("ON")
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  specGroups SpecGroup[]
  orderItems OrderItem[]

  @@index([tenantId, status, sort])
  @@index([categoryId])
}

/// 规格组（如「辣度」，单选必选）
model SpecGroup {
  id       String @id @default(cuid())
  tenantId String
  productId String
  name     String
  required Boolean @default(true)
  multiple Boolean @default(false)
  sort     Int     @default(0)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  options SpecOption[]

  @@index([productId])
}

/// 规格选项 / 加料（priceDelta 为加价，分）
model SpecOption {
  id              String  @id @default(cuid())
  tenantId        String
  groupId         String
  name            String
  priceDelta      Int     @default(0)
  sort            Int     @default(0)
  defaultSelected Boolean @default(false)

  group SpecGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

/// 顾客（小程序用户，按租户隔离 openid）
model Customer {
  id          String    @id @default(cuid())
  tenantId    String
  openid      String
  nickname    String?
  avatarUrl   String?
  phone       String?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  @@unique([tenantId, openid])
  @@index([tenantId, phone])
}

/// 订单
model Order {
  id            String    @id @default(cuid())
  orderNo       String    @unique
  tenantId      String
  storeId       String
  tableId       String?
  tableName     String?
  type          String    @default("DINE_IN")
  status        String    @default("UNPAID")
  payStatus     String    @default("UNPAID")
  customerId    String?
  customerName  String?
  peopleCount   Int?
  remark        String?

  /// 外卖收货信息
  receiverName  String?
  receiverPhone String?
  address       String?
  deliveryFee   Int      @default(0)
  deliveryEta   Int?

  /// 商品金额（分）
  itemAmount     Int      @default(0)
  discountAmount Int      @default(0)
  packingFee     Int      @default(0)
  totalAmount    Int      @default(0)
  paidAmount     Int      @default(0)

  pickupNo       Int?
  transactionId  String?  @unique
  outTradeNo     String?
  idempotencyKey String?
  payChannel     String?

  acceptAt    DateTime?
  readyAt     DateTime?
  completeAt  DateTime?
  cancelAt    DateTime?
  cancelReason String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  OrderItem[]
  refunds Refund[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([storeId, createdAt])
}

/// 订单明细（下单时快照商品名/价格/规格，避免菜单改价影响历史订单）
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  tenantId    String
  productId   String?
  productName String
  imageUrl    String?
  /// 含规格加价的单价（分）
  unitPrice   Int
  quantity    Int
  amount      Int
  specText    String?
  addonText   String?
  remark      String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// 支付流水
model PaymentRecord {
  id            String    @id @default(cuid())
  tenantId      String
  orderId       String
  outTradeNo    String    @unique
  transactionId String?
  amount        Int
  channel       String    @default("WECHAT")
  status        String    @default("UNPAID")
  raw           String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([tenantId, createdAt])
}

/// 退款单
model Refund {
  id            String    @id @default(cuid())
  refundNo      String    @unique
  tenantId      String
  orderId       String
  amount        Int
  status        String    @default("PROCESSING")
  reason        String?
  transactionId String?
  operatorName  String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// 操作审计日志（改价、退款、支付配置修改等）
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorType  String
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}
