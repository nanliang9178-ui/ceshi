.mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: rgba(23, 24, 28, 0.45);
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sheet {
  width: 100%;
  max-height: 82vh;
  background: #fff;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes slideUp {
  from {
    transform: translateY(60%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-head {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.head-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f7f2ec;
}

.head-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.head-name {
  font-size: 32rpx;
  font-weight: 600;
  padding-right: 60rpx;
}

.head-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.head-price {
  margin-top: 12rpx;
  color: var(--brand);
  font-size: 22rpx;
}

.head-price .price {
  font-size: 38rpx;
  color: var(--brand);
}

.close-btn {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(23, 24, 28, 0.05);
  color: var(--ink-3);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-body {
  flex: 1;
  max-height: 46vh;
  padding: 8rpx 32rpx;
}

.group {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.group:last-child {
  border-bottom: none;
}

.group-title {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.group-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.group-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.options {
  display: flex;
  flex-wrap: wrap;
}

.option {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 32rpx;
  background: #f7f3ee;
  color: var(--ink-2);
  font-size: 25rpx;
  border: 1rpx solid transparent;
  transition: all 0.16s;
}

.option.selected {
  background: var(--brand-light);
  border-color: var(--brand);
  color: var(--brand);
  font-weight: 500;
}

.option-price {
  margin-left: 8rpx;
  font-size: 21rpx;
  opacity: 0.8;
}

.no-spec {
  padding: 40rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 24rpx;
}

.sheet-foot {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid var(--line);
  background: #fff;
}

.stepper {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f7f3ee;
  color: var(--ink);
  font-size: 32rpx;
  line-height: 54rpx;
  text-align: center;
}

.step-btn.disabled {
  color: #cfc7bd;
}

.step-num {
  width: 72rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', sans-serif;
}

.confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-dark));
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx -16rpx rgba(255, 90, 31, 0.9);
}

.confirm-btn.disabled {
  background: #d9d2ca;
  box-shadow: none;
}
