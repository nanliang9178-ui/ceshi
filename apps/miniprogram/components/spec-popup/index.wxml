<view wx:if="{{show}}" class="mask" bindtap="close" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head">
      <image wx:if="{{imageUrl}}" class="head-img" src="{{imageUrl}}" mode="aspectFill" />
      <view wx:else class="head-img head-fallback">🍲</view>
      <view class="flex-1">
        <view class="head-name ellipsis">{{productName}}</view>
        <view class="head-desc ellipsis">{{description}}</view>
        <view class="head-price">
          <text class="price-symbol">¥</text>
          <text class="price">{{totalText}}</text>
        </view>
      </view>
      <view class="close-btn" bindtap="close">✕</view>
    </view>

    <scroll-view scroll-y class="sheet-body">
      <view wx:for="{{groups}}" wx:key="id" wx:for-index="groupIndex" class="group">
        <view class="group-title">
          <text class="group-name">{{item.name}}</text>
          <text class="group-tag">{{item.required ? '必选' : '可选'}}{{item.multiple ? ' · 可多选' : ''}}</text>
        </view>
        <view class="options">
          <view
            wx:for="{{item.options}}"
            wx:for-item="option"
            wx:key="id"
            wx:for-index="optionIndex"
            class="option {{option.selected ? 'selected' : ''}}"
            data-group-index="{{groupIndex}}"
            data-option-index="{{optionIndex}}"
            bindtap="onOptionTap"
          >
            <text>{{option.name}}</text>
            <text wx:if="{{option.priceText}}" class="option-price">{{option.priceText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{groups.length === 0}}" class="no-spec">该菜品无需选择规格</view>
    </scroll-view>

    <view class="sheet-foot safe-bottom">
      <view class="stepper">
        <view class="step-btn {{quantity <= 1 ? 'disabled' : ''}}" bindtap="dec">−</view>
        <view class="step-num">{{quantity}}</view>
        <view class="step-btn" bindtap="inc">+</view>
      </view>
      <view class="confirm-btn {{soldOut ? 'disabled' : ''}}" bindtap="confirm">
        {{soldOut ? '已售罄' : '加入购物车 · ¥' + totalText}}
      </view>
    </view>
  </view>
</view>
