.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 24rpx -20rpx rgba(23, 24, 28, 0.35);
  border-top: 1rpx solid rgba(23, 24, 28, 0.05);
}

.tab {
  position: relative;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9e9e9e;
}

.tab.active {
  color: var(--brand, #ff5a1f);
}

.icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  color: inherit;
}

.label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: inherit;
  letter-spacing: 0.5rpx;
}

/* 首页：屋顶 + 房子 */
.roof {
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 26rpx;
  height: 26rpx;
  margin-left: -13rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
  border-radius: 4rpx 0 0 0;
}

.house {
  position: absolute;
  left: 7rpx;
  bottom: 2rpx;
  width: 28rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
}

/* 点单：杯子 */
.lid {
  position: absolute;
  left: 7rpx;
  top: 4rpx;
  width: 28rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.cup {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 22rpx;
  height: 27rpx;
  border: 4rpx solid currentColor;
  border-top: none;
  border-radius: 2rpx 2rpx 10rpx 10rpx;
}

/* 订单：清单 */
.line {
  position: absolute;
  left: 7rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.line.l1 {
  top: 9rpx;
  width: 28rpx;
}

.line.l2 {
  top: 19rpx;
  width: 28rpx;
}

.line.l3 {
  top: 29rpx;
  width: 18rpx;
}

/* 我的：头像 */
.head {
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.body {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 30rpx;
  height: 18rpx;
  margin-left: -15rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}

.active-dot {
  position: absolute;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.9;
}
