<view class="tabbar" style="--brand: {{theme}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="icon icon-{{item.icon}}">
      <block wx:if="{{item.icon === 'home'}}">
        <view class="roof"></view>
        <view class="house"></view>
      </block>
      <block wx:elif="{{item.icon === 'cup'}}">
        <view class="lid"></view>
        <view class="cup"></view>
      </block>
      <block wx:elif="{{item.icon === 'list'}}">
        <view class="line l1"></view>
        <view class="line l2"></view>
        <view class="line l3"></view>
      </block>
      <block wx:else>
        <view class="head"></view>
        <view class="body"></view>
      </block>
    </view>
    <text class="label">{{item.text}}</text>
    <view wx:if="{{selected === index}}" class="active-dot"></view>
  </view>
</view>
