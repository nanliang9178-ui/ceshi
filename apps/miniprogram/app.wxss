page {
  --brand: #ff5a1f;
  --brand-light: #fff4ed;
  --brand-dark: #e8451a;
  --accent: #f2b544;
  --ink: #1a1a1a;
  --ink-2: #6b6b6b;
  --ink-3: #9e9e9e;
  --cream: #fbf7f2;
  --line: #ede7e0;

  background: var(--cream);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
image,
scroll-view {
  box-sizing: border-box;
}

/* ---------- 通用组件 ---------- */
.card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 28rpx -18rpx rgba(23, 24, 28, 0.18);
}

.card-flat {
  background: #fff;
  border-radius: 24rpx;
  border: 1rpx solid var(--line);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.muted {
  color: var(--ink-3);
  font-size: 24rpx;
}

.price {
  font-family: 'DIN Alternate', -apple-system, sans-serif;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.5rpx;
}

.price-symbol {
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 2rpx;
}

.brand-text {
  color: var(--brand);
}

/* 主按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-dark));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 16rpx 32rpx -16rpx rgba(255, 90, 31, 0.85);
}

.btn-primary.disabled {
  background: #d9d2ca;
  box-shadow: none;
  color: #fff;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 38rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--ink-2);
  font-size: 26rpx;
}

.btn-ghost:active {
  background: #f7f2ec;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 500;
}

.tag-plain {
  background: rgba(23, 24, 28, 0.05);
  color: var(--ink-2);
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

.page-bottom-space {
  height: 200rpx;
}

/* 加购圆形按钮 */
.add-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), var(--brand-dark));
  color: #fff;
  font-size: 34rpx;
  line-height: 50rpx;
  text-align: center;
  box-shadow: 0 8rpx 16rpx -8rpx rgba(255, 90, 31, 0.9);
  transition: transform 0.12s ease;
}

.add-btn:active {
  transform: scale(0.86);
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--line);
}

/* 骨架屏 */
.sk {
  background: linear-gradient(90deg, #efe8e0 25%, #f7f2ec 37%, #efe8e0 63%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
  border-radius: 12rpx;
}

@keyframes sk {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* 入场动画 */
.fade-up {
  animation: fadeUp 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 28rpx;
  color: var(--ink-2);
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
}
