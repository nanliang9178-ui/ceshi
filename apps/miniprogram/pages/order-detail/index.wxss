.page {
  min-height: 100vh;
  background: var(--cream);
  padding: 24rpx 24rpx 0;
}

/* 状态头 */
.status-head {
  padding: 44rpx 40rpx 56rpx;
  border-radius: 36rpx;
  background: linear-gradient(150deg, var(--brand), var(--brand-dark));
  color: #fff;
  position: relative;
  overflow: hidden;
}

.status-head.cancelled {
  background: linear-gradient(150deg, #6b6b6b, #3a3b45);
}

.status-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.status-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.pickup-box {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
}

.pickup-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.66);
}

.pickup-no {
  display: block;
  margin-top: 4rpx;
  font-family: 'DIN Alternate', sans-serif;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.pickup-no .unit {
  margin-left: 4rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* 配送信息 */
.delivery-card {
  padding: 22rpx 26rpx;
}

.dc-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}

.dc-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.dc-addr {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  line-height: 1.55;
}

/* 进度 */
.steps-card {
  display: flex;
  margin-top: -28rpx;
  padding: 32rpx 20rpx 26rpx;
  position: relative;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-dot-wrap {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 28rpx;
}

.step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e2dad1;
  z-index: 2;
  transition: all 0.2s;
}

.step-dot.done {
  background: var(--brand);
}

.step-dot.active {
  width: 24rpx;
  height: 24rpx;
  background: var(--brand);
  box-shadow: 0 0 0 8rpx rgba(255, 90, 31, 0.14);
}

.step-line {
  position: absolute;
  left: 50%;
  width: 100%;
  height: 3rpx;
  background: #eee7df;
  z-index: 1;
}

.step-line.done {
  background: var(--brand);
  opacity: 0.45;
}

.step-label {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.step-label.done {
  color: var(--ink-2);
}

.step-label.active {
  color: var(--brand);
  font-weight: 600;
}

/* 取消 */
.cancel-card {
  margin-top: -28rpx;
  padding: 32rpx;
}

.cancel-title {
  font-size: 30rpx;
  font-weight: 600;
}

.cancel-reason {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.cancel-tip {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f4f8f4;
  color: #127a4c;
  font-size: 22rpx;
}

/* 卡片 */
.card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4efe8;
}

.item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 18rpx;
  background: #f7f2ec;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.item-img-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.item-name {
  font-size: 27rpx;
  font-weight: 500;
}

.item-spec {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.item-remark {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--brand);
}

.item-right {
  text-align: right;
  margin-left: 16rpx;
}

.item-amount {
  font-size: 26rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', sans-serif;
}

.item-qty {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 费用 */
.fee-card {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.fee-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 25rpx;
  color: var(--ink-2);
}

.fee-line.discount {
  color: var(--brand);
}

.fee-line.total {
  border-top: 1rpx solid #f4efe8;
  margin-top: 8rpx;
  padding-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.total-price {
  display: flex;
  align-items: baseline;
  color: var(--brand);
}

.total-price .price {
  font-size: 38rpx;
  color: var(--brand);
}

/* 信息 */
.info-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-key {
  font-size: 24rpx;
  color: var(--ink-3);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-val {
  font-size: 24rpx;
  color: var(--ink-2);
  text-align: right;
  word-break: break-all;
}

.copy {
  margin-left: 8rpx;
  color: var(--brand);
}

/* 底部操作 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 18rpx 24rpx;
  background: #fff;
  box-shadow: 0 -12rpx 32rpx -26rpx rgba(23, 24, 28, 0.4);
}

.action-ghost {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 30rpx;
  margin-left: 16rpx;
  border-radius: 38rpx;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 25rpx;
  background: #fff;
}

.action-primary {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
  margin-left: 16rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-dark));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx -14rpx rgba(255, 90, 31, 0.9);
}
