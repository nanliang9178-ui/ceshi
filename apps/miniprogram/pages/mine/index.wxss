.page {
  min-height: 100vh;
  background: var(--cream);
  padding: 24rpx 24rpx 60rpx;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(140deg, var(--brand), var(--brand-dark));
  color: #fff;
  box-shadow: 0 18rpx 36rpx -22rpx rgba(255, 90, 31, 0.9);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 600;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
}

.user-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
}

.bind-btn::after {
  border: none;
}

.bind-btn {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 24rpx;
  border-radius: 31rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--brand);
  font-size: 23rpx;
  font-weight: 600;
  margin: 0;
}

.bound-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 21rpx;
}

.card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
}

.cell {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f4efe8;
}

.cell:last-child {
  border-bottom: none;
}

.cell:active {
  background: #faf7f3;
}

.cell-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #f9f5f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cell-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}

.cell-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.cell-badge {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 20rpx;
  margin-right: 12rpx;
}

.cell-arrow {
  font-size: 34rpx;
  color: #d5cec5;
  line-height: 1;
}

.tips {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
}

.tips-title {
  font-size: 25rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.tips-text {
  font-size: 22rpx;
  line-height: 1.9;
  color: var(--ink-3);
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
}

.tab-space {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
