<view class="page" style="--brand: {{theme}}">
  <view class="tabs">
    <view class="tab {{tab === 'active' ? 'active' : ''}}" data-tab="active" bindtap="switchTab">
      进行中
      <view wx:if="{{all.length}}" class="tab-dot"></view>
    </view>
    <view class="tab {{tab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="switchTab">全部订单</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="sk" style="height: 220rpx; margin: 24rpx;"></view>
    <view class="sk" style="height: 220rpx; margin: 24rpx;"></view>
  </block>

  <block wx:elif="{{error}}">
    <view class="empty">
      <view class="empty-icon">📡</view>
      <view class="empty-title">{{error}}</view>
      <view class="btn-ghost" style="margin-top: 32rpx;" bindtap="retry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{list.length === 0}}">
    <view class="empty">
      <view class="empty-icon">🧾</view>
      <view class="empty-title">{{tab === 'active' ? '暂无进行中的订单' : '还没有下过单'}}</view>
      <view class="empty-desc">扫码点单后，订单会出现在这里</view>
      <view class="btn-primary" style="margin-top: 40rpx; padding: 0 56rpx;" bindtap="goMenu">去点单</view>
    </view>
  </block>

  <block wx:else>
    <view wx:for="{{list}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="openOrder">
      <view class="card-head">
        <view class="head-left">
          <text class="table-tag {{item.isDelivery ? 'delivery' : ''}}">{{item.placeText}}</text>
          <text class="pickup" wx:if="{{item.pickupNo}}">#{{item.pickupNo}}</text>
        </view>
        <text class="status {{item.isActive ? 'active' : ''}}">{{item.statusLabel}}</text>
      </view>

      <view class="card-body">
        <view class="goods ellipsis">{{item.summaryText}}</view>
        <view wx:if="{{item.remark}}" class="remark ellipsis">备注：{{item.remark}}</view>
        <view class="meta">
          <text class="meta-time">{{item.timeText}}</text>
          <view class="meta-right">
            <text class="count">共 {{item.itemCount}} 件</text>
            <text class="amount">¥{{item.totalText}}</text>
          </view>
        </view>
      </view>

      <view class="card-foot">
        <text class="order-no">{{item.orderNo}}</text>
        <view class="foot-btn">{{item.isActive ? '查看进度' : '查看详情'}} →</view>
      </view>
    </view>

    <view class="list-end">— 仅展示最近 50 笔订单 —</view>
  </block>

  <view class="tab-space"></view>
</view>
