.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cream);
}

.scroll {
  flex: 1;
  padding: 24rpx 24rpx 0;
}

.block {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 用餐方式 */
.type-row {
  display: flex;
}

.type-item {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 24rpx;
  background: #f7f3ee;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-item:first-child {
  margin-right: 20rpx;
}

.type-item.active {
  background: var(--brand-light);
  border-color: var(--brand);
}

.type-item.disabled {
  opacity: 0.45;
}

.type-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.type-item.active .type-title {
  color: var(--brand);
}

.type-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.closed-tip {
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: #fff7e8;
  color: #b7791f;
  font-size: 23rpx;
}

/* 外卖表单 */
.form-line {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f6f1ea;
}

.form-line.column {
  flex-direction: column;
  align-items: stretch;
  padding: 18rpx 0;
}

.form-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--ink-2);
}

.form-input {
  flex: 1;
  height: 60rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.form-textarea {
  width: 100%;
  min-height: 96rpx;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f9f6f1;
  font-size: 25rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.ph {
  color: #c2bab1;
  font-size: 24rpx;
}

.form-error {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 22rpx;
}

.form-tip {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 清单 */
.block-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.block-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
}

.goods {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4efe8;
}

.goods:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.g-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: #f7f2ec;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.g-img-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.g-name {
  font-size: 27rpx;
  font-weight: 500;
}

.g-spec {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.g-price {
  margin-top: 6rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: 'DIN Alternate', sans-serif;
}

.g-qty {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-left: 16rpx;
}

/* 信息 */
.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.line.column {
  flex-direction: column;
  align-items: stretch;
  border-top: 1rpx solid #f4efe8;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.line-label {
  font-size: 26rpx;
  color: var(--ink-2);
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f7f3ee;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 54rpx;
  text-align: center;
}

.step-btn.disabled {
  color: #cfc7bd;
}

.step-btn.plus {
  background: var(--brand-light);
  color: var(--brand);
}

.step-num {
  width: 72rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', sans-serif;
}

.remark {
  width: 100%;
  min-height: 100rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f9f6f1;
  font-size: 25rpx;
  line-height: 1.6;
}

.remark-ph {
  color: #c2bab1;
  font-size: 24rpx;
}

/* 费用 */
.fee-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: var(--ink-2);
}

.fee-val {
  font-family: 'DIN Alternate', sans-serif;
  color: var(--ink);
}

.fee-line.discount .fee-val {
  color: var(--brand);
}

.fee-line.total {
  border-top: 1rpx solid #f4efe8;
  margin-top: 10rpx;
  padding-top: 20rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.total-price {
  display: flex;
  align-items: baseline;
  color: var(--brand);
}

.total-price .price {
  font-size: 40rpx;
  color: var(--brand);
}

.hint {
  padding: 0 12rpx 12rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 底部 */
.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #fff;
  box-shadow: 0 -12rpx 32rpx -24rpx rgba(23, 24, 28, 0.4);
}

.pay-left {
  display: flex;
  align-items: baseline;
}

.pay-label {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-right: 10rpx;
}

.pay-amount {
  display: flex;
  align-items: baseline;
  color: var(--brand);
}

.pay-amount .price {
  font-size: 42rpx;
  color: var(--brand);
}

.pay-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 56rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-dark));
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 28rpx -16rpx rgba(255, 90, 31, 0.9);
}

.pay-btn.disabled {
  background: #d9d2ca;
  box-shadow: none;
}
